{
  "name": "ontology_validator",
  "description": "Validate ontology fragments and layered artifacts against contracts",
  "command": "python scripts/validate_output_contracts.py --analysis-manifest <manifest>",
  "script_path": "scripts/validate_output_contracts.py",
  "category": "ontology",
  "enabled": true,
  "args_schema": {
    "manifest": {
      "type": "string",
      "required": true
    }
  },
  "layer_scope": [
    "L0",
    "L1",
    "L2",
    "L2.5",
    "L3"
  ],
  "version": "2.0.0",
  "business_domain": [
    "SUPPLY_CHAIN",
    "MANUFACTURING",
    "DATA_MESH",
    "MASTER_DATA"
  ],
  "output_schema": {
    "type": "object",
    "required": [
      "validation_result",
      "errors",
      "warnings"
    ],
    "properties": {
      "validation_result": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "validation_status": {
            "type": "string",
            "enum": [
              "pass",
              "warning",
              "fail"
            ]
          },
          "overall_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "schema_validation": {
            "type": "object",
            "properties": {
              "passed": {
                "type": "boolean"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "errors": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "evidence_validation": {
            "type": "object",
            "properties": {
              "passed": {
                "type": "boolean"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "coverage_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "errors": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "consistency_validation": {
            "type": "object",
            "properties": {
              "passed": {
                "type": "boolean"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "conflicts": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "completeness_validation": {
            "type": "object",
            "properties": {
              "passed": {
                "type": "boolean"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "missing_fields": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "required": [
          "valid",
          "validation_status"
        ]
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "error_id": {
              "type": "string"
            },
            "error_type": {
              "type": "string",
              "enum": [
                "schema_violation",
                "missing_field",
                "invalid_value",
                "evidence_missing",
                "conflict",
                "inconsistency"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "critical",
                "high",
                "medium"
              ]
            },
            "entity_id": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "suggestion": {
              "type": "string"
            }
          },
          "required": [
            "error_id",
            "error_type",
            "severity",
            "message"
          ]
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "warning_id": {
              "type": "string"
            },
            "warning_type": {
              "type": "string",
              "enum": [
                "missing_optional_field",
                "low_confidence",
                "deprecated_type",
                "potential_duplicate"
              ]
            },
            "entity_id": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "warning_id",
            "warning_type",
            "message"
          ]
        }
      },
      "summary": {
        "type": "object",
        "properties": {
          "total_errors": {
            "type": "integer",
            "minimum": 0
          },
          "total_warnings": {
            "type": "integer",
            "minimum": 0
          },
          "critical_errors": {
            "type": "integer",
            "minimum": 0
          },
          "high_errors": {
            "type": "integer",
            "minimum": 0
          },
          "medium_errors": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "quality_thresholds": {},
  "trace_config": {
    "log_model_name": true,
    "log_prompt_version": true,
    "log_execution_time": true,
    "log_retries": true
  }
}
