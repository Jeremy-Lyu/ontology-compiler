{
  "skill_id": "l25_mbom_extraction",
  "name": "MBOM与物料场景提取",
  "description": "从文档中提取MBOM结构、物料主数据、排产相关实体",
  "version": "1.0.0",
  "category": "cross_layer",
  "tags": [
    "MBOM",
    "物料清单",
    "排产",
    "制造",
    "供应链"
  ],
  "trigger": {
    "keywords": [
      "MBOM",
      "物料清单",
      "BOM",
      "父件",
      "子件",
      "物料编码",
      "排产",
      "生产订单",
      "工艺路线",
      "MRP"
    ],
    "file_patterns": [
      "*mbom*",
      "*bom*",
      "*material*"
    ],
    "min_confidence": 0.7,
    "supported_layers": [
      "L0",
      "L1",
      "L2",
      "L2.5"
    ],
    "domain_tags": [
      "MANUFACTURING",
      "SUPPLY_CHAIN"
    ],
    "regex_patterns": [
      "\\b\\d{8,12}\\b",
      "\\b[A-Z]-\\d{3,6}\\b",
      "\\b\\d+\\.\\d+\\s*(EA|KG|M|PC|SET)\\b"
    ]
  },
  "input_schema": {
    "type": "object",
    "description": "文档内容输入",
    "fields": [
      {
        "name": "content",
        "type": "string",
        "required": true,
        "description": "文档文本内容"
      },
      {
        "name": "domain",
        "type": "string",
        "required": false,
        "description": "业务域提示"
      }
    ]
  },
  "output_schema": {
    "type": "object",
    "description": "提取的实体和关系",
    "fields": [
      {
        "name": "entities",
        "type": "array",
        "required": true,
        "description": "实体列表"
      },
      {
        "name": "relationships",
        "type": "array",
        "required": false,
        "description": "关系列表"
      },
      {
        "name": "confidence",
        "type": "float",
        "required": false,
        "description": "置信度"
      }
    ]
  },
  "preconditions": [],
  "postconditions": [],
  "supported_layers": [
    "L0",
    "L1",
    "L2",
    "L2.5"
  ],
  "dependencies": [],
  "business_domain": [
    "MANUFACTURING",
    "SUPPLY_CHAIN"
  ],
  "status": "active",
  "classification_contract": {
    "name": "MBOM分类契约",
    "description": "MBOM相关文档分类规则",
    "applicable_domains": [
      "MANUFACTURING",
      "SUPPLY_CHAIN"
    ],
    "applicable_document_types": [],
