{
  "name": "capsule_publisher",
  "description": "Publish ontology deltas and verified artifact updates",
  "command": "python scripts/publish_delta_to_master.py --delta <delta>",
  "script_path": "scripts/publish_delta_to_master.py",
  "category": "ontology",
  "enabled": true,
  "args_schema": {
    "delta": {
      "type": "string",
      "required": true
    }
  },
  "layer_scope": [
    "L0",
    "L1",
    "L2",
    "L2.5",
    "L3"
  ],
  "version": "2.0.0",
  "business_domain": [
    "SUPPLY_CHAIN",
    "MANUFACTURING",
    "DATA_MESH",
    "MASTER_DATA"
  ],
  "output_schema": {
    "type": "object",
    "required": [
      "publish_result",
      "artifact_info"
    ],
    "properties": {
      "publish_result": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "publish_time": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "success"
        ]
      },
      "artifact_info": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "hash": {
            "type": "string"
          },
          "backup_location": {
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "location"
        ]
      },
      "validation_result": {
        "type": "object",
        "properties": {
          "validated": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "summary": {
        "type": "object",
        "properties": {
          "total_artifacts": {
            "type": "integer",
            "minimum": 0
          },
          "published_artifacts": {
            "type": "integer",
            "minimum": 0
          },
          "failed_artifacts": {
            "type": "integer",
            "minimum": 0
          },
          "total_size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "quality_thresholds": {},
  "trace_config": {
    "log_model_name": true,
    "log_prompt_version": true,
    "log_execution_time": true,
    "log_retries": true
  }
}
