{
  "name": "business_rule_extraction",
  "description": "从文档中提取业务规则，包括条件规则、约束规则和审批规则",
  "command": "python src/skills/semantic_organization/business_rule_extraction/business_rule_extraction.py --input <input_text>",
  "script_path": "src/skills/semantic_organization/business_rule_extraction/business_rule_extraction.py",
  "category": "semantic_organization",
  "layer_scope": ["L2", "L2.5"],
  "enabled": true,
  "version": "2.0.0",
  "business_domain": ["SUPPLY_CHAIN", "MANUFACTURING", "DATA_MESH", "MASTER_DATA"],
  "args_schema": {
    "input_text": {
      "type": "string",
      "required": true,
      "description": "输入文本内容"
    },
    "rule_types": {
      "type": "array",
      "items": {"type": "string"},
      "description": "目标规则类型列表"
    }
  },
  "output_schema": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "rule_type", "conditions", "actions"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "rule_type": {"type": "string"},
          "conditions": {"type": "array", "items": {"type": "object"}},
          "actions": {"type": "array", "items": {"type": "object"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_ref": {"type": "string"}
        }
      }
    }
  },
  "preconditions": ["input_text must be non-empty"],
  "quality_thresholds": {
    "min_confidence": 0.65,
    "min_completeness": 0.5,
    "max_conflict_count": 2,
    "review_threshold": 0.8
  },
  "trace_config": {
    "log_model_name": true,
    "log_prompt_version": true,
    "log_execution_time": true,
    "log_retries": true
  }
}