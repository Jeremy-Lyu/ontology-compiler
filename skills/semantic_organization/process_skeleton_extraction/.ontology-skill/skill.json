{
  "name": "process_skeleton_extraction",
  "description": "提取文档中的业务流程骨架，识别流程节点和流转关系",
  "command": "python src/skills/semantic_organization/process_skeleton_extraction/process_skeleton_extraction.py --input <input_text>",
  "script_path": "src/skills/semantic_organization/process_skeleton_extraction/process_skeleton_extraction.py",
  "category": "semantic_organization",
  "layer_scope": ["L2", "L2.5"],
  "enabled": true,
  "version": "2.0.0",
  "business_domain": ["SUPPLY_CHAIN", "MANUFACTURING", "DATA_MESH", "MASTER_DATA"],
  "args_schema": {
    "input_text": {
      "type": "string",
      "required": true,
      "description": "输入文本内容"
    },
    "process_types": {
      "type": "array",
      "items": {"type": "string"},
      "description": "目标流程类型列表"
    }
  },
  "output_schema": {
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "nodes", "edges"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "nodes": {"type": "array", "items": {"type": "object"}},
          "edges": {"type": "array", "items": {"type": "object"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  },
  "preconditions": ["input_text must be non-empty"],
  "quality_thresholds": {
    "min_confidence": 0.6,
    "min_completeness": 0.4,
    "review_threshold": 0.75
  },
  "trace_config": {
    "log_model_name": true,
    "log_prompt_version": true,
    "log_execution_time": true,
    "log_retries": true
  }
}