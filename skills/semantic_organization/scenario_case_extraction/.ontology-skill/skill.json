{
  "name": "scenario_case_extraction",
  "description": "提取文档中的业务场景案例，包括场景描述、参与角色和关键步骤",
  "command": "python src/skills/semantic_organization/scenario_case_extraction/scenario_case_extraction.py --input <input_text>",
  "script_path": "src/skills/semantic_organization/scenario_case_extraction/scenario_case_extraction.py",
  "category": "semantic_organization",
  "layer_scope": ["L2.5", "L3"],
  "enabled": true,
  "version": "2.0.0",
  "business_domain": ["SUPPLY_CHAIN", "MANUFACTURING", "DATA_MESH", "MASTER_DATA"],
  "args_schema": {
    "input_text": {
      "type": "string",
      "required": true,
      "description": "输入文本内容"
    },
    "scenario_types": {
      "type": "array",
      "items": {"type": "string"},
      "description": "目标场景类型列表"
    }
  },
  "output_schema": {
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "actors", "steps"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "actors": {"type": "array", "items": {"type": "string"}},
          "steps": {"type": "array", "items": {"type": "object"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_ref": {"type": "string"}
        }
      }
    }
  },
  "preconditions": ["input_text must be non-empty"],
  "quality_thresholds": {
    "min_confidence": 0.55,
    "min_completeness": 0.4,
    "review_threshold": 0.7
  },
  "trace_config": {
    "log_model_name": true,
    "log_prompt_version": true,
    "log_execution_time": true,
    "log_retries": true
  }
}