{
  "name": "metadata_enrichment",
  "description": "根据文档类型触发结构化 metadata 展开，为实体补充 operational/manufacturing/reporting/policy context",
  "category": "workflow",
  "layer_scope": [
    "L1",
    "L2",
    "L2.5",
    "L3"
  ],
  "enabled": true,
  "version": "1.1.0",
  "business_domain": [
    "SUPPLY_CHAIN",
    "MANUFACTURING",
    "ENTERPRISE"
  ],
  "priority": "normal",
  "trigger_conditions": {
    "stage": "extract",
    "after_stage": "entity_classification",
    "when_document_type_matches": [
      "pptx",
      "docx",
      "md",
      "pdf"
    ]
  },
  "args_schema": {
    "entities": {
      "type": "array",
      "required": true,
      "description": "待 enrichment 的实体列表"
    },
    "document_type": {
      "type": "string",
      "required": true,
      "description": "文档类型"
    },
    "document_content": {
      "type": "string",
      "required": false,
      "description": "原始文档内容（用于提取 metadata）"
    }
  },
  "output_schema": {
    "enriched_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "meta_id": {
            "type": "string"
          },
          "structured_metadata": {
            "type": "object"
          },
          "metadata_context_type": {
            "type": "string"
          },
          "enrichment_source": {
            "type": "string"
          }
        }
      }
    },
    "enrichment_count": {
      "type": "integer"
    },
    "context_types_triggered": {
      "type": "array"
    }
  },
  "preconditions": [
    "entities must be non-empty",
    "document_type must be recognized"
  ],
  "quality_thresholds": {
    "min_enrichment_coverage": 0.3,
    "max_spurious_metadata_fields": 5
  },
  "trace_config": {
    "log_context_types": true,
    "log_enrichment_count": true,
    "log_execution_time": true
  },
  "source_of_truth": "src/pipeline/metadata_enrichment.py",
  "context_mapping": {
    "simple": [],
    "factory_inventory": [
      "operational_context"
    ],
    "mbom_bom_bop": [
      "manufacturing_context"
    ],
    "kpi_report": [
      "reporting_context"
    ],
    "compliance_safety": [
      "policy_context"
    ]
  },
  "command": "python -m ontology_compiler.skills.builtin.metadata_enrichment_skill",
  "script_path": "ontology_compiler/skills/builtin/metadata_enrichment_skill.py"
}
