{
  "name": "entity_recognition",
  "description": "识别文档中的本体实体，提取实体名称、类型、位置和置信度",
  "command": "python src/skills/perception/entity_recognition/entity_recognition.py --input <input_text> --entity_types <entity_types>",
  "script_path": "src/skills/perception/entity_recognition/entity_recognition.py",
  "category": "perception",
  "layer_scope": ["L0", "L1", "L2", "L2.5", "L3"],
  "enabled": true,
  "version": "2.0.0",
  "business_domain": ["SUPPLY_CHAIN", "MANUFACTURING", "DATA_MESH", "MASTER_DATA"],
  "args_schema": {
    "input_text": {
      "type": "string",
      "required": true,
      "description": "输入文本内容"
    },
    "entity_types": {
      "type": "array",
      "items": {"type": "string"},
      "required": true,
      "description": "目标实体类型列表"
    },
    "language": {
      "type": "string",
      "default": "zh",
      "description": "语言代码"
    }
  },
  "output_schema": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "surface", "type", "span", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "surface": {"type": "string"},
          "type": {"type": "string"},
          "span": {"type": "object", "required": ["start", "end"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_ref": {"type": "string"}
        }
      }
    }
  },
  "preconditions": ["input_text must be non-empty", "entity_types must contain valid ontology types"],
  "quality_thresholds": {
    "min_confidence": 0.7,
    "min_evidence_coverage": 0.5,
    "max_duplicate_rate": 0.2,
    "review_threshold": 0.8
  },
  "trace_config": {
    "log_model_name": true,
    "log_prompt_version": true,
    "log_execution_time": true,
    "log_retries": true
  }
}