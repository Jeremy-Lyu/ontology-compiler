{
  "name": "relation_extraction",
  "description": "从文本中提取实体之间的关系，生成结构化的关系三元组",
  "command": "python src/skills/perception/relation_extraction/relation_extraction.py --input <input_text> --entities <entities>",
  "script_path": "src/skills/perception/relation_extraction/relation_extraction.py",
  "category": "perception",
  "layer_scope": ["L0", "L1", "L2", "L2.5", "L3"],
  "enabled": true,
  "version": "2.0.0",
  "business_domain": ["SUPPLY_CHAIN", "MANUFACTURING", "DATA_MESH", "MASTER_DATA"],
  "args_schema": {
    "input_text": {
      "type": "string",
      "required": true,
      "description": "输入文本内容"
    },
    "entities": {
      "type": "array",
      "items": {"type": "object"},
      "required": true,
      "description": "已识别的实体列表"
    },
    "relation_types": {
      "type": "array",
      "items": {"type": "string"},
      "description": "允许的关系类型列表"
    }
  },
  "output_schema": {
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "target_id", "relation_type", "confidence"],
        "properties": {
          "source_id": {"type": "string"},
          "target_id": {"type": "string"},
          "relation_type": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_ref": {"type": "string"}
        }
      }
    }
  },
  "preconditions": ["input_text must be non-empty", "entities must contain at least 2 entities"],
  "quality_thresholds": {
    "min_confidence": 0.6,
    "min_evidence_coverage": 0.4,
    "max_conflict_count": 3,
    "review_threshold": 0.75
  },
  "trace_config": {
    "log_model_name": true,
    "log_prompt_version": true,
    "log_execution_time": true,
    "log_retries": true
  }
}