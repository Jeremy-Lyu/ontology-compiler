{
  "name": "attribute_extraction",
  "description": "提取实体的属性信息，包括代码、描述、状态等业务属性",
  "command": "python src/skills/perception/attribute_extraction/attribute_extraction.py --input <input_text> --entities <entities>",
  "script_path": "src/skills/perception/attribute_extraction/attribute_extraction.py",
  "category": "perception",
  "layer_scope": ["L1", "L2", "L2.5", "L3"],
  "enabled": true,
  "version": "2.0.0",
  "business_domain": ["SUPPLY_CHAIN", "MANUFACTURING", "DATA_MESH", "MASTER_DATA"],
  "args_schema": {
    "input_text": {
      "type": "string",
      "required": true,
      "description": "输入文本内容"
    },
    "entities": {
      "type": "array",
      "items": {"type": "object"},
      "required": true,
      "description": "已识别的实体列表"
    },
    "attribute_types": {
      "type": "array",
      "items": {"type": "string"},
      "description": "目标属性类型列表"
    }
  },
  "output_schema": {
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "name", "value", "confidence"],
        "properties": {
          "entity_id": {"type": "string"},
          "name": {"type": "string"},
          "value": {"type": ["string", "number", "boolean"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_ref": {"type": "string"}
        }
      }
    }
  },
  "preconditions": ["input_text must be non-empty", "entities must be provided"],
  "quality_thresholds": {
    "min_confidence": 0.65,
    "min_completeness": 0.5,
    "max_duplicate_rate": 0.15,
    "review_threshold": 0.8
  },
  "trace_config": {
    "log_model_name": true,
    "log_prompt_version": true,
    "log_execution_time": true,
    "log_retries": true
  }
}