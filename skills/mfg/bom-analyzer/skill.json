{
  "name": "bom_timeseries_analysis",
  "description": "基于多时间点CSV快照的BOM变更分析、配置空间分析和替换关系识别",
  "command": "scripts/diagnostics/run_bom_timeseries_analysis.py",
  "script_path": "scripts/diagnostics/run_bom_timeseries_analysis.py",
  "category": "workflow",
  "layer_scope": [
    "L1",
    "L2",
    "L2.5"
  ],
  "enabled": true,
  "version": "1.0.0",
  "business_domain": [
    "SUPPLY_CHAIN",
    "MANUFACTURING",
    "DATA_MESH",
    "MASTER_DATA"
  ],
  "args_schema": {
    "csv_files": {
      "type": "array",
      "required": true,
      "description": "时间序列CSV文件路径列表"
    },
    "analysis_type": {
      "type": "string",
      "required": true,
      "description": "分析类型",
      "enum": [
        "change_audit",
        "config_space",
        "replacement_detection",
        "full_analysis"
      ]
    },
    "pos_key_fields": {
      "type": "array",
      "required": false,
      "description": "POS标识字段",
      "default": [
        "ISPECGRP",
        "ISPECPOS"
      ]
    },
    "material_field": {
      "type": "string",
      "required": false,
      "description": "物料号字段名",
      "default": "ISTUK35"
    },
    "version_field": {
      "type": "string",
      "required": false,
      "description": "版本/变更单号字段名",
      "default": "DSCIMOD"
    }
  },
  "output_schema": {
    "change_report": {
      "type": "object"
    },
    "config_space": {
      "type": "object"
    },
    "replacements": {
      "type": "array"
    },
    "confidence_summary": {
      "type": "object"
    }
  },
  "quality_thresholds": {},
  "trace_config": {
    "log_model_name": true,
    "log_prompt_version": true,
    "log_execution_time": true,
    "log_retries": true
  }
}