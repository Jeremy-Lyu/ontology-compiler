# =============================================================================
# F-1 (2026-08-15): Python / build artifacts
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
*.manifest
*.spec

# =============================================================================
# F-1: Virtual environments & package managers
# =============================================================================
.venv/
venv/
env/
ENV/
.python-version
uv.lock
poetry.lock

# =============================================================================
# F-1: Test / tooling caches
# =============================================================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# =============================================================================
# F-1: IDE / editor
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# =============================================================================
# F-1: Secrets — never commit credentials
# =============================================================================
config/env.env
*.env
.env
env.env
*.pem
*.key
secrets/

# =============================================================================
# F-1: Runtime artifacts (ONTOLOGY PIPELINE)
# Large generated/derived outputs are regenerable; keep them out of the repo
# to limit repo size and index cost (P0 in CQ_PIPELINE_IMPLEMENTATION_PLAN).
# =============================================================================
outputs/
runs/
traces/
logs/
*.bak
*.backup_*.json
Archive.zip
master_ontology_unified.backup_*.json

# P0-7 (2026-09-09): live master store is runtime derived state — the
# regression baseline master source lives under outputs/runs/ontology/
# (already ignored) and the store is rebuilt by --write-baseline runs.
master_ontology/

# P0-7 (2026-09-09): editor / scratch leftovers
.trae/
_p0_*.txt

# P0-7 (2026-09-09): business input documents stay local-only (may contain
# sensitive engineering content). Regressions reference data/ paths.
data/

# P0-7 (2026-09-09): local git store (security tool blocks a literal
# `.git/` directory's config+hooks, so repo uses --separate-git-dir).
# `.git` in worktree is a pointer FILE, never a directory. Store must stay
# untracked: `/.gitstore/`

# =============================================================================
# F-1: Scratch / temp
# =============================================================================
tmp/
temp/
*.tmp
*.log
scratch/
sandbox/

# =============================================================================
# P0-7 (2026-09-09): separate git store — see comment above
# =============================================================================
/.gitstore/
