    "regression_root": "outputs/runs/ontology/pipeline/"
  },
  "acceptance": {
    "description": "Global acceptance thresholds for the dual-layer (extract/merge) golden semantic gate. Baseline observed: (2026-08-30, n=1) REG-mbom-du-v2-20260830-102509 extract_entity_recall=1.0/merge_entity_recall=0.6667/entity_retention=0.6667; (2026-08-31, n=2) relation thresholds added after endpoint fixes (fragment-priority name index + canonical anchor guard), REG-ebom-mbom-2023-20260831-101917 + REG-production-inventory-md-20260831-103054 observe extract/merge relation_recall=1.0 and relation_retention=1.0 (previously 0.0). (2026-08-31, n=7) FULL production baseline --production --write-baseline PASS=7/FAIL=0, layered_golden_summary all dims mean=1.0 (extract/merge entity+relation recall, entity/relation retention). TIGHTENED 2026-08-31: merge/retention thresholds raised 0.5/0.8 -> 1.0 to lock in the achieved all-1.0 baseline (any golden miss or merge loss now fails the gate; extract thresholds were already 1.0). Other global checks unchanged.",
    "classification_consistency_min": 0.95,
    "relationship_precision_min": 0.9,
    "related_to_share_max": 0.05,
    "dedup_mismerge_rate_max": 0.01,
    "evidence_coverage_min": 0.98,
    "rollback_success_min": 1.0,
    "single_file_max_runtime_s": 300,
    "extract_entity_recall_min": 1.0,
    "merge_entity_recall_min": 1.0,
    "entity_retention_min": 1.0,
    "extract_relation_recall_min": 1.0,
    "merge_relation_recall_min": 1.0,
    "relation_retention_min": 1.0
  },
  "compare_with": {
    "before": "outputs/runs/ontology/baselines/regression_summary_baseline.json",
    "after": "outputs/runs/ontology/pipeline/regression_reports/latest_regression_summary.json"
  }
