{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-unified.local/schemas/asset_packet/evidence.schema.json",
  "title": "Evidence Asset Schema",
  "type": "object",
  "required": ["version", "evidence"],
  "properties": {
    "version": {"type": "string", "const": "2.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string"},
    "total_count": {"type": "integer", "minimum": 0},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "content", "source_file", "entity_refs"],
        "properties": {
          "id": {"type": "string"},
          "content": {"type": "string"},
          "source_file": {"type": "string"},
          "source_line": {"type": "integer"},
          "source_page": {"type": "integer"},
          "entity_refs": {"type": "array", "items": {"type": "string"}},
          "relation_refs": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "chunk_id": {"type": "string"},
          "embedding": {"type": "array", "items": {"type": "number"}}
        }
      }
    }
  }
}