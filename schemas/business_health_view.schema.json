{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-unified.local/schemas/business_health_view.schema.json",
  "title": "Business Health View",
  "type": "object",
  "required": ["generated_at", "aggregate_summary", "topics"],
  "properties": {
    "generated_at": {"type": "string"},
    "aggregate_summary": {
      "type": "object",
      "required": ["total_runs", "success_runs", "runs_with_warnings", "totals", "layered_quality"],
      "properties": {
        "total_runs": {"type": "integer"},
        "success_runs": {"type": "integer"},
        "runs_with_warnings": {"type": "integer"},
        "totals": {
          "type": "object",
          "required": ["nodes", "instances", "relationships", "llm_calls", "total_tokens"],
          "properties": {
            "nodes": {"type": "integer"},
            "instances": {"type": "integer"},
            "relationships": {"type": "integer"},
            "llm_calls": {"type": "number"},
            "total_tokens": {"type": "number"}
          },
          "additionalProperties": true
        },
        "layered_quality": {
          "type": "object",
          "required": ["l1", "l2"],
          "properties": {
            "l1": {
              "type": "object",
              "required": ["avg_node_completeness", "avg_evidence_coverage", "total_rule_conflicts"],
              "properties": {
                "avg_node_completeness": {"type": "number"},
                "avg_evidence_coverage": {"type": "number"},
                "total_rule_conflicts": {"type": "integer"}
              },
              "additionalProperties": true
            },
            "l2": {
              "type": "object",
              "required": ["avg_stale_ratio", "avg_binding_valid_ratio", "avg_refresh_sla_ratio"],
              "properties": {
                "avg_stale_ratio": {"type": "number"},
                "avg_binding_valid_ratio": {"type": "number"},
                "avg_refresh_sla_ratio": {"type": "number"}
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topic_id",
          "run_id",
          "status",
          "health_score",
          "risk",
          "nodes",
          "instances",
          "relationships",
          "warnings",
          "warning_detail",
          "l1_completeness",
          "l2_binding",
          "started_at",
          "finished_at",
          "source_folder"
        ],
        "properties": {
          "topic_id": {"type": "string"},
          "run_id": {"type": "string"},
          "status": {"type": "string"},
          "health_score": {"type": "number"},
          "risk": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
          "nodes": {"type": "integer"},
          "instances": {"type": "integer"},
          "relationships": {"type": "integer"},
          "warnings": {"type": "integer"},
          "warning_detail": {
            "type": "array",
            "items": {"type": "string"}
          },
          "l1_completeness": {"type": "number"},
          "l2_binding": {"type": "number"},
          "started_at": {"type": ["string", "null"]},
          "finished_at": {"type": ["string", "null"]},
          "source_folder": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

