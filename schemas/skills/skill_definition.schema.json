{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-unified.local/schemas/skills/skill_definition.schema.json",
  "title": "Skill Definition Schema",
  "description": "Canonical skill definition contract for all ontology skills.",
  "type": "object",
  "required": ["skill_id", "name", "version", "description"],
  "properties": {
    "contract_name": {"type": "string", "const": "skill_definition"},
    "contract_version": {"type": "string", "default": "1.0.0"},
    "skill_id": {"type": "string"},
    "name": {"type": "string"},
    "version": {"type": "string"},
    "status": {"type": "string", "enum": ["stable", "maturing", "deprecated"]},
    "owner": {"type": "string"},
    "description": {"type": "string"},
    "command": {"type": "string"},
    "script_path": {"type": "string"},
    "category": {"type": "string"},
    "enabled": {"type": "boolean", "default": true},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "business_domain": {"type": "array", "items": {"type": "string"}},
    "layer_scope": {"type": "array", "items": {"type": "string"}},
    "input_schema": {"type": "object"},
    "output_schema": {"type": "object"},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "postconditions": {"type": "array", "items": {"type": "string"}},
    "side_effects": {"type": "array", "items": {"type": "string"}},
    "determinism": {"type": "string", "enum": ["deterministic", "non_deterministic"]},
    "idempotent": {"type": "boolean"},
    "required_evidence": {"type": "boolean"},
    "fallback_skills": {"type": "array", "items": {"type": "string"}},
    "compatible_pipeline_stages": {"type": "array", "items": {"type": "string"}},
    "metrics": {"type": "array", "items": {"type": "string"}},
    "quality_thresholds": {"type": "object"},
    "trace_config": {"type": "object"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "deprecation": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
