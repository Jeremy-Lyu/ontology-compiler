{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-unified.local/schemas/skills/document_router.schema.json",
  "title": "Document Router Skill Schema",
  "type": "object",
  "required": ["skill_name", "skill_version", "context", "input", "output", "quality", "trace"],
  "properties": {
    "skill_name": {"type": "string", "const": "document_router"},
    "skill_version": {"type": "string"},
    "context": {"$ref": "../shared/skill_envelope.schema.json#/definitions/context"},
    "input": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string"},
        "document_type_hint": {"type": "string"},
        "domain_hint": {"type": "string"}
      }
    },
    "output": {
      "type": "object",
      "required": ["document_type", "route_name", "skill_chain"],
      "properties": {
        "document_type": {"type": "string"},
        "business_domain": {"type": "string"},
        "route_name": {"type": "string", "description": "Routing name identifier, e.g., 'manufacturing_sop', 'engineering_spec', 'supply_chain_ops'"},
        "skill_chain": {"type": "array", "items": {"type": "string"}, "description": "Ordered list of skill names to execute in pipeline"},
        "route": {"type": "array", "items": {"type": "string"}, "description": "DEPRECATED: Use skill_chain instead"},
        "routing_reason": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "signals": {"type": "array", "items": {"type": "string"}, "description": "Key signals that influenced routing decision"}
      }
    },
    "quality": {"$ref": "../shared/skill_envelope.schema.json#/definitions/quality"},
    "trace": {"$ref": "../shared/skill_envelope.schema.json#/definitions/trace"},
    "warnings": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/warning"}},
    "errors": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/error"}}
  }
}
