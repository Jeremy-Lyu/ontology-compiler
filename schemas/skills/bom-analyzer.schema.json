{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-unified.local/schemas/skills/bom-analyzer.schema.json",
  "title": "BOM Analyzer Skill Schema",
  "type": "object",
  "required": ["skill_name", "skill_version", "context", "input", "output", "quality", "trace"],
  "properties": {
    "skill_name": {"type": "string", "const": "bom-analyzer"},
    "skill_version": {"type": "string"},
    "context": {"$ref": "../shared/skill_envelope.schema.json#/definitions/context"},
    "input": {
      "type": "object",
      "required": ["bom_data", "schema_rules"],
      "properties": {
        "bom_data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "part_number": {"type": "string"},
              "part_name": {"type": "string"},
              "parent_id": {"type": "string"},
              "quantity": {"type": "number"},
              "level": {"type": "integer"}
            }
          }
        },
        "schema_rules": {
          "type": "object",
          "properties": {
            "required_fields": {"type": "array", "items": {"type": "string"}},
            "valid_part_number_pattern": {"type": "string"},
            "max_hierarchy_level": {"type": "integer"}
          }
        },
        "reference_bom": {"type": "array", "items": {"type": "object"}}
      }
    },
    "output": {
      "type": "object",
      "required": ["analysis_result", "issues", "quality_score"],
      "properties": {
        "analysis_result": {
          "type": "object",
          "properties": {
            "validity": {"type": "string", "enum": ["valid", "partial", "invalid"]},
            "completeness": {"type": "number", "minimum": 0, "maximum": 1},
            "consistency": {"type": "number", "minimum": 0, "maximum": 1},
            "total_parts": {"type": "integer", "minimum": 0},
            "total_levels": {"type": "integer", "minimum": 0},
            "missing_components": {"type": "integer", "minimum": 0},
            "extra_components": {"type": "integer", "minimum": 0},
            "conflicting_relations": {"type": "integer", "minimum": 0}
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "issue_id": {"type": "string"},
              "issue_type": {"type": "string", "enum": ["missing_part", "duplicate_part", "invalid_part_number", "missing_relation", "conflict", "incomplete_data", "schema_violation"]},
              "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
              "part_number": {"type": "string"},
              "description": {"type": "string"},
              "suggestion": {"type": "string"}
            },
            "required": ["issue_id", "issue_type", "severity"]
          }
        },
        "quality_score": {"type": "number", "minimum": 0, "maximum": 1},
        "recommendations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "quality": {"$ref": "../shared/skill_envelope.schema.json#/definitions/quality"},
    "trace": {"$ref": "../shared/skill_envelope.schema.json#/definitions/trace"},
    "warnings": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/warning"}},
    "errors": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/error"}}
  }
}