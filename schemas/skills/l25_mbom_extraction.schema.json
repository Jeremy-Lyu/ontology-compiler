{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-unified.local/schemas/skills/l25_mbom_extraction.schema.json",
  "title": "L2.5 MBOM Extraction Skill Schema",
  "type": "object",
  "required": ["skill_name", "skill_version", "context", "input", "output", "quality", "trace"],
  "properties": {
    "skill_name": {"type": "string", "const": "l25_mbom_extraction"},
    "skill_version": {"type": "string"},
    "context": {"$ref": "../shared/skill_envelope.schema.json#/definitions/context"},
    "input": {
      "type": "object",
      "required": ["text", "document_metadata"],
      "properties": {
        "text": {"type": "string"},
        "document_metadata": {
          "type": "object",
          "properties": {
            "document_type": {"type": "string"},
            "domain": {"type": "string"},
            "source_file": {"type": "string"}
          }
        },
        "existing_entities": {"type": "array", "items": {"type": "object"}},
        "bom_config": {
          "type": "object",
          "properties": {
            "max_level": {"type": "integer", "minimum": 1, "default": 5},
            "include_variants": {"type": "boolean", "default": true},
            "include_attributes": {"type": "boolean", "default": true}
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["bom_hierarchy", "entities", "relations", "evidence"],
      "properties": {
        "bom_hierarchy": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bom_node_id": {"type": "string"},
              "parent_id": {"type": "string"},
              "level": {"type": "integer", "minimum": 1},
              "part_number": {"type": "string"},
              "part_name": {"type": "string"},
              "quantity": {"type": "number"},
              "unit": {"type": "string"},
              "variant_code": {"type": "string"},
              "attributes": {"type": "object"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "required": ["bom_node_id", "part_number", "part_name"]
          }
        },
        "entities": {"type": "array", "items": {"type": "object"}},
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "relation_type": {"type": "string", "enum": ["HAS_PART", "CONTAINS", "DEPENDS_ON", "REPLACES"]},
              "from": {"type": "string"},
              "to": {"type": "string"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "required": ["relation_type", "from", "to"]
          }
        },
        "evidence": {"type": "array", "items": {"type": "object"}},
        "summary": {
          "type": "object",
          "properties": {
            "total_bom_nodes": {"type": "integer", "minimum": 0},
            "total_levels": {"type": "integer", "minimum": 1},
            "total_relations": {"type": "integer", "minimum": 0},
            "extraction_coverage": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "quality": {"$ref": "../shared/skill_envelope.schema.json#/definitions/quality"},
    "trace": {"$ref": "../shared/skill_envelope.schema.json#/definitions/trace"},
    "warnings": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/warning"}},
    "errors": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/error"}}
  }
}