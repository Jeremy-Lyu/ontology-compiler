{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-unified.local/schemas/skills/stage-runner.schema.json",
  "title": "Stage Runner Skill Schema",
  "type": "object",
  "required": ["skill_name", "skill_version", "context", "input", "output", "quality", "trace"],
  "properties": {
    "skill_name": {"type": "string", "const": "stage-runner"},
    "skill_version": {"type": "string"},
    "context": {"$ref": "../shared/skill_envelope.schema.json#/definitions/context"},
    "input": {
      "type": "object",
      "required": ["stage_id", "stage_config", "input_data"],
      "properties": {
        "stage_id": {"type": "string"},
        "stage_config": {
          "type": "object",
          "properties": {
            "stage_name": {"type": "string"},
            "stage_type": {"type": "string"},
            "timeout_ms": {"type": "integer", "minimum": 0},
            "retry_count": {"type": "integer", "minimum": 0},
            "required_skills": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["stage_name"]
        },
        "input_data": {"type": "object"},
        "pipeline_context": {
          "type": "object",
          "properties": {
            "pipeline_id": {"type": "string"},
            "run_id": {"type": "string"},
            "stage_index": {"type": "integer", "minimum": 0},
            "total_stages": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["stage_output", "execution_status", "metrics"],
      "properties": {
        "stage_output": {"type": "object"},
        "execution_status": {
          "type": "object",
          "properties": {
            "status": {"type": "string", "enum": ["success", "failed", "timed_out", "skipped"]},
            "error_message": {"type": "string"},
            "retry_count": {"type": "integer", "minimum": 0},
            "execution_time_ms": {"type": "integer", "minimum": 0}
          },
          "required": ["status"]
        },
        "metrics": {
          "type": "object",
          "properties": {
            "input_size": {"type": "integer", "minimum": 0},
            "output_size": {"type": "integer", "minimum": 0},
            "processed_items": {"type": "integer", "minimum": 0},
            "skipped_items": {"type": "integer", "minimum": 0},
            "error_items": {"type": "integer", "minimum": 0}
          }
        },
        "next_stage": {"type": "string"},
        "branch_decision": {
          "type": "object",
          "properties": {
            "branch_id": {"type": "string"},
            "reason": {"type": "string"}
          }
        }
      }
    },
    "quality": {"$ref": "../shared/skill_envelope.schema.json#/definitions/quality"},
    "trace": {"$ref": "../shared/skill_envelope.schema.json#/definitions/trace"},
    "warnings": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/warning"}},
    "errors": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/error"}}
  }
}