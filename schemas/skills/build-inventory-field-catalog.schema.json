{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-unified.local/schemas/skills/build-inventory-field-catalog.schema.json",
  "title": "Build Inventory Field Catalog Skill Schema",
  "type": "object",
  "required": ["skill_name", "skill_version", "context", "input", "output", "quality", "trace"],
  "properties": {
    "skill_name": {"type": "string", "const": "build-inventory-field-catalog"},
    "skill_version": {"type": "string"},
    "context": {"$ref": "../shared/skill_envelope.schema.json#/definitions/context"},
    "input": {
      "type": "object",
      "required": ["documents"],
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "document_id": {"type": "string"},
              "text": {"type": "string"},
              "document_type": {"type": "string"}
            },
            "required": ["document_id", "text"]
          }
        },
        "existing_catalog": {"type": "array", "items": {"type": "object"}}
      }
    },
    "output": {
      "type": "object",
      "required": ["field_catalog", "mappings"],
      "properties": {
        "field_catalog": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field_id": {"type": "string"},
              "field_name": {"type": "string"},
              "canonical_name": {"type": "string"},
              "data_type": {"type": "string", "enum": ["string", "number", "date", "boolean", "enum", "object", "array"]},
              "unit": {"type": "string"},
              "validation_rules": {
                "type": "object",
                "properties": {
                  "min_value": {"type": "number"},
                  "max_value": {"type": "number"},
                  "pattern": {"type": "string"},
                  "allowed_values": {"type": "array", "items": {"type": "string"}}
                }
              },
              "description": {"type": "string"},
              "source_documents": {"type": "array", "items": {"type": "string"}},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "required": ["field_id", "field_name", "data_type"]
          }
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_field": {"type": "string"},
              "canonical_field_id": {"type": "string"},
              "mapping_confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "transformation_rules": {"type": "string"}
            },
            "required": ["source_field", "canonical_field_id"]
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "total_fields": {"type": "integer", "minimum": 0},
            "new_fields": {"type": "integer", "minimum": 0},
            "updated_fields": {"type": "integer", "minimum": 0},
            "duplicate_fields": {"type": "integer", "minimum": 0},
            "coverage_rate": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "quality": {"$ref": "../shared/skill_envelope.schema.json#/definitions/quality"},
    "trace": {"$ref": "../shared/skill_envelope.schema.json#/definitions/trace"},
    "warnings": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/warning"}},
    "errors": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/error"}}
  }
}