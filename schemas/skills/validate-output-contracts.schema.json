{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-unified.local/schemas/skills/validate-output-contracts.schema.json",
  "title": "Validate Output Contracts Skill Schema",
  "type": "object",
  "required": ["skill_name", "skill_version", "context", "input", "output", "quality", "trace"],
  "properties": {
    "skill_name": {"type": "string", "const": "validate-output-contracts"},
    "skill_version": {"type": "string"},
    "context": {"$ref": "../shared/skill_envelope.schema.json#/definitions/context"},
    "input": {
      "type": "object",
      "required": ["output_data", "contract_schema"],
      "properties": {
        "output_data": {"type": "object"},
        "contract_schema": {
          "type": "object",
          "properties": {
            "schema_id": {"type": "string"},
            "schema_version": {"type": "string"},
            "json_schema": {"type": "object"},
            "required_fields": {"type": "array", "items": {"type": "string"}},
            "allowed_entity_types_by_layer": {
              "type": "object",
              "additionalProperties": {"type": "array", "items": {"type": "string"}}
            },
            "allowed_relation_types": {"type": "array", "items": {"type": "string"}},
            "required_evidence": {"type": "boolean", "default": true},
            "quality_requirements": {"type": "object"},
            "trace_requirements": {"type": "object"}
          },
          "required": ["schema_id", "json_schema"]
        },
        "validation_options": {
          "type": "object",
          "properties": {
            "strict_mode": {"type": "boolean", "default": false},
            "check_quality": {"type": "boolean", "default": true},
            "check_evidence": {"type": "boolean", "default": true},
            "check_trace": {"type": "boolean", "default": true},
            "check_semantics": {"type": "boolean", "default": true}
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["validation_result", "violations"],
      "properties": {
        "validation_result": {
          "type": "object",
          "properties": {
            "valid": {"type": "boolean"},
            "status": {"type": "string", "enum": ["pass", "warning", "fail"]},
            "schema_validation": {
              "type": "object",
              "properties": {
                "passed": {"type": "boolean"},
                "errors": {"type": "integer", "minimum": 0}
              }
            },
            "quality_validation": {
              "type": "object",
              "properties": {
                "passed": {"type": "boolean"},
                "score": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            "evidence_validation": {
              "type": "object",
              "properties": {
                "passed": {"type": "boolean"},
                "coverage_rate": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            "semantic_validation": {
              "type": "object",
              "properties": {
                "passed": {"type": "boolean"},
                "entity_type_coverage": {"type": "number", "minimum": 0, "maximum": 1},
                "relationship_validity_rate": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            "trace_validation": {
              "type": "object",
              "properties": {
                "passed": {"type": "boolean"},
                "complete": {"type": "boolean"}
              }
            }
          },
          "required": ["valid", "status"]
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "violation_id": {"type": "string"},
              "violation_type": {"type": "string", "enum": ["schema_violation", "missing_field", "invalid_type", "quality_failure", "evidence_missing", "trace_missing", "semantic_violation", "relationship_violation"]},
              "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
              "field": {"type": "string"},
              "message": {"type": "string"},
              "expected": {"type": "string"},
              "actual": {"type": "string"},
              "suggestion": {"type": "string"}
            },
            "required": ["violation_id", "violation_type", "severity", "message"]
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "total_violations": {"type": "integer", "minimum": 0},
            "critical_violations": {"type": "integer", "minimum": 0},
            "high_violations": {"type": "integer", "minimum": 0},
            "medium_violations": {"type": "integer", "minimum": 0},
            "low_violations": {"type": "integer", "minimum": 0},
            "contract_compliance_rate": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "quality": {"$ref": "../shared/skill_envelope.schema.json#/definitions/quality"},
    "trace": {"$ref": "../shared/skill_envelope.schema.json#/definitions/trace"},
    "warnings": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/warning"}},
    "errors": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/error"}}
  }
}