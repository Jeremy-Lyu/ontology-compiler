{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-unified.local/schemas/skills/attribute_extraction.schema.json",
  "title": "Attribute Extraction Skill Schema",
  "type": "object",
  "required": ["skill_name", "skill_version", "context", "input", "output", "quality", "trace"],
  "properties": {
    "skill_name": {"type": "string", "const": "attribute_extraction"},
    "skill_version": {"type": "string"},
    "context": {"$ref": "../shared/skill_envelope.schema.json#/definitions/context"},
    "input": {
      "type": "object",
      "required": ["text", "target_entities", "allowed_attributes"],
      "properties": {
        "text": {"type": "string"},
        "target_entities": {"type": "array", "items": {"type": "object"}},
        "allowed_attributes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "output": {
      "type": "object",
      "required": ["attributes"],
      "properties": {
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity_id", "name", "value"],
            "properties": {
              "entity_id": {"type": "string"},
              "name": {"type": "string"},
              "value": {},
              "unit": {"type": "string"},
              "normalized_value": {},
              "evidence_span": {"type": "string"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "quality": {"$ref": "../shared/skill_envelope.schema.json#/definitions/quality"},
    "trace": {"$ref": "../shared/skill_envelope.schema.json#/definitions/trace"},
    "warnings": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/warning"}},
    "errors": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/error"}}
  }
}
