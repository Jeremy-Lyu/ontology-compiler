{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-unified.local/schemas/skills/process_skeleton_extraction.schema.json",
  "title": "Process Skeleton Extraction Skill Schema",
  "type": "object",
  "required": ["skill_name", "skill_version", "context", "input", "output", "quality", "trace"],
  "properties": {
    "skill_name": {"type": "string", "const": "process_skeleton_extraction"},
    "skill_version": {"type": "string"},
    "context": {"$ref": "../shared/skill_envelope.schema.json#/definitions/context"},
    "input": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string"},
        "process_family": {"type": "string"},
        "domain": {"type": "string"}
      }
    },
    "output": {
      "type": "object",
      "required": ["activities", "control_flow"],
      "properties": {
        "process_name": {"type": "string"},
        "activities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "role": {"type": "string"},
              "order": {"type": "integer"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        },
        "control_flow": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {"type": "string"},
              "to": {"type": "string"},
              "type": {"type": "string"},
              "condition": {"type": "string"}
            }
          }
        },
        "decision_points": {"type": "array", "items": {"type": "object"}},
        "roles": {"type": "array", "items": {"type": "string"}}
      }
    },
    "quality": {"$ref": "../shared/skill_envelope.schema.json#/definitions/quality"},
    "trace": {"$ref": "../shared/skill_envelope.schema.json#/definitions/trace"},
    "warnings": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/warning"}},
    "errors": {"type": "array", "items": {"$ref": "../shared/skill_envelope.schema.json#/definitions/error"}}
  }
}
