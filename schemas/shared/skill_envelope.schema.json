{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-unified.local/schemas/shared/skill_envelope.schema.json",
  "title": "Skill Envelope Schema",
  "description": "Unified skill envelope contract: quality, trace, warnings, errors shared definitions",
  "type": "object",
  "definitions": {
    "quality": {
      "type": "object",
      "properties": {
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "duplicate_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "conflict_count": {"type": "integer", "minimum": 0},
        "review_required": {"type": "boolean"},
        "needs_review": {"type": "boolean"}
      }
    },
    "trace": {
      "type": "object",
      "properties": {
        "model_name": {"type": "string"},
        "prompt_version": {"type": "string"},
        "skill_version": {"type": "string"},
        "execution_time_ms": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "upstream_skills": {"type": "array", "items": {"type": "string"}},
        "parent_request_id": {"type": "string"},
        "pipeline_id": {"type": "string"},
        "step_id": {"type": "string"},
        "request_id": {"type": "string"}
      }
    },
    "warning": {
      "type": "object",
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "severity": {"type": "string", "enum": ["info", "warning", "error"]},
        "field": {"type": "string"},
        "details": {"type": "object"}
      },
      "required": ["code", "message"]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "severity": {"type": "string", "enum": ["error", "critical"]},
        "field": {"type": "string"},
        "details": {"type": "object"},
        "retryable": {"type": "boolean"}
      },
      "required": ["code", "message"]
    },
    "context": {
      "type": "object",
      "properties": {
        "tenant": {"type": "string"},
        "business_unit": {"type": "string"},
        "domain": {"type": "string"},
        "document_id": {"type": "string"},
        "chunk_id": {"type": "string"},
        "language": {"type": "string"},
        "source_system": {"type": "string"},
        "business_domain": {"type": "string"},
        "document_type": {"type": "string"}
      }
    }
  }
}